# A minimal out-of-tree consumer of libophtml-console.a. It exists to
# prove the core archive links against a main the console's own Makefile
# did not build (compiled and link-checked in CI, not booted). Needs the
# ps2dev toolchain, and the built-in theme blob (examples/console/build.sh
# bakes it):
#
# Build flags are not tracked across trees: after a
# `make -C console MOCK=1 ROMPAD=1`, the console tree holds ROM-pad
# objects, and a plain archive wants `make -C console objclean` first
# (CI does this before the gate). The $(CORE_LIB) rule below always
# delegates to the console Makefile so it, not a stale timestamp here,
# decides whether to rebuild.
#
#   ./examples/console/build.sh
#   make -C examples/console-min
#
# There is no host test: every line here is EE-only, so CI's elf job is
# the arbiter, the same as console/ itself.

EE_BIN   = console-min.elf
CORE     = ../../console
CORE_LIB = $(CORE)/libophtml-console.a

# The module list comes FROM console/Makefile, not a copy, so the two
# cannot drift (the #186 review's concern). embed_irx.sh then bakes
# those modules into this consumer's own table.
IRX := $(shell $(MAKE) -s -C $(CORE) print-irx)

# Reuse examples/console's built-in blob; this example bakes none of
# its own. In CI the elf job has it from the bake job's artifact.
THEME ?= ../console/build/ui.uib

EE_OBJS = main.o ps2ui.o theme_uib.o irx_table.o

EE_CFLAGS  += -std=c99 -Wall -I$(CORE) -I$(PS2DEV)/gsKit/include \
              -I$(PS2SDK)/ports/include
EE_LDFLAGS += -L$(CORE) -L$(PS2DEV)/gsKit/lib -L$(PS2SDK)/ports/lib
# -lophtml-console first, before the system libs its members call into,
# exactly as console/Makefile orders them.
EE_LIBS     = -lophtml-console -lgskit -ldmakit -lpad -lpatches \
              -lfileXio -lelf-loader

all: $(EE_BIN)

# Build the core archive in the console tree, then link against it.
# FORCE so the console Makefile is always asked (see the header note):
# this rule has no view of the flags storage.o was built with, so it
# must not treat an existing archive as up to date.
$(CORE_LIB): FORCE
	$(MAKE) -C $(CORE) libophtml-console.a

FORCE:

$(EE_BIN): $(CORE_LIB)

# Copy the runtime sources in so PS2SDK's implicit %.o rule builds them
# with its full include set, as runtime/sample does.
ps2ui.c: ../../runtime/ps2ui.c ../../runtime/ps2ui.h
	cp ../../runtime/ps2ui.h ps2ui.h
	cp ../../runtime/ps2ui.c ps2ui.c

ps2ui.o: ps2ui.c
main.o: ps2ui.c

theme_uib.c: $(THEME)
	$(PS2SDK)/bin/bin2c $(THEME) theme_uib.c theme_uib

# This consumer's own module table, generated by the console tree's
# embed_irx.sh so its layout matches the storage.o inside the archive.
irx_table.c irx_table.h: $(CORE)/embed_irx.sh
	sh $(CORE)/embed_irx.sh . $(IRX)
irx_table.o: irx_table.h

clean: objclean
	rm -f $(EE_BIN)
	$(MAKE) -C $(CORE) objclean

objclean:
	rm -f $(EE_OBJS) theme_uib.c ps2ui.c ps2ui.h irx_table.c irx_table.h

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal
